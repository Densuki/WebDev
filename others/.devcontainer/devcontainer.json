{
  "name": "Etheriuscraft Network Site",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "dockerComposeFile": "docker-compose.yml",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ecmel.vscode-html-css",
        "formulahendry.auto-rename-tag",
        "vincaslt.highlight-matching-tag",
        "pranaygp.vscode-css-peek",
        "mgmcdermott.vscode-language-babel",
        "xabikos.javascriptsnippets",
        "aaron-bond.better-comments",
        "anseki.vscode-color",
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",
        "esbenp.prettier-vscode",
        "kisstkondoros.vscode-gutter-preview",
        "naumovs.color-highlight",
        "pkief.material-icon-theme",
        "dracula-theme.theme-dracula",
        "ms-ceintl.vscode-language-pack-pt-br",
        "ms-vscode.live-server",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "Github-Suriya.wad-api-preview",
        "mongodb.mongodb-vscode"
      ],
      "settings": {
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "editor.formatOnSave": true,
        "workbench.iconTheme": "material-icon-theme",
        "workbench.colorTheme": "Dracula",
        "files.autoSave": "onFocusChange"
      }
    }
  },
  "postCreateCommand": "git lfs install --force && bash -c 'if [ -f backend/requirements.txt ]; then python -m pip install -r backend/requirements.txt; else echo \"No Python requirements\"; fi; if [ -f frontend/package.json ]; then cd frontend && npm install; else echo \"No frontend package.json\"; fi'",
  "remoteUser": "vscode"
}
